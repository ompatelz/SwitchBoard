# Safe gateway defaults. This file must never contain real credentials.
SWITCHBOARD_MOCK_PROVIDER_URL=http://127.0.0.1:8001
# Optional second mock endpoint. Leave unset for one-provider operation.
# SWITCHBOARD_SECONDARY_MOCK_PROVIDER_URL=http://127.0.0.1:8002
SWITCHBOARD_PROVIDER_MAX_ATTEMPTS=2
SWITCHBOARD_PROVIDER_DEADLINE_SECONDS=15
SWITCHBOARD_CIRCUIT_FAILURE_THRESHOLD=3
SWITCHBOARD_CIRCUIT_RECOVERY_SECONDS=10
SWITCHBOARD_UPSTREAM_CONNECT_TIMEOUT_SECONDS=2.0
SWITCHBOARD_UPSTREAM_READ_TIMEOUT_SECONDS=10.0
SWITCHBOARD_UPSTREAM_WRITE_TIMEOUT_SECONDS=2.0
SWITCHBOARD_UPSTREAM_POOL_TIMEOUT_SECONDS=1.0
